[Unit]
Description=Oosta encrypted database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/oosta-backup
User=root
UMask=0077
TimeoutStartSec=300
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/oostaAI/shared/backups /run/lock
